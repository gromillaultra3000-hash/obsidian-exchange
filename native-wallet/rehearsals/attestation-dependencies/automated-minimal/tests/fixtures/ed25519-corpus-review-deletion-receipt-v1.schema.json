{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.obsidian.invalid/native-wallet/ed25519-corpus-review-deletion-receipt-v1.schema.json",
  "title": "Hash-only external review-copy deletion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "bundle_sha256",
    "retention_policy_sha256",
    "workspace_inventory_sha256",
    "deletion_plan_sha256",
    "caller_nonce_sha256",
    "receipt_sha256",
    "subject_data_class",
    "trigger",
    "triggered_at_epoch_ms",
    "completed_at_epoch_ms",
    "locations_expected",
    "locations_attempted",
    "locations_failed",
    "ordinary_backup_copies_expected",
    "post_deletion_scan_sha256",
    "executor_domain_id",
    "witness_domain_id",
    "executor_witness_independent",
    "outcome",
    "physical_erasure_proven"
  ],
  "properties": {
    "schema": { "const": "native-wallet-ed25519-corpus-review-deletion-receipt.v1" },
    "receipt_id": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "retention_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workspace_inventory_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "deletion_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "caller_nonce_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "subject_data_class": { "enum": ["external_sensitive_evidence", "webauthn_assertion_bytes"] },
    "trigger": { "enum": ["DECISION_FINAL", "EXPIRED", "CONSENT_WITHDRAWN", "INCIDENT"] },
    "triggered_at_epoch_ms": { "type": "integer", "minimum": 1 },
    "completed_at_epoch_ms": { "type": "integer", "minimum": 1 },
    "locations_expected": { "type": "integer", "minimum": 1, "maximum": 64 },
    "locations_attempted": { "type": "integer", "minimum": 1, "maximum": 64 },
    "locations_failed": { "type": "integer", "minimum": 0, "maximum": 64 },
    "ordinary_backup_copies_expected": { "const": 0 },
    "post_deletion_scan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "executor_domain_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "witness_domain_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "executor_witness_independent": { "const": true },
    "outcome": { "enum": ["COMPLETE", "PARTIAL", "FAILED", "UNKNOWN"] },
    "physical_erasure_proven": { "const": false }
  },
  "complete_requires": [
    "locations_attempted equals locations_expected",
    "locations_failed equals zero",
    "executor and witness domains differ",
    "post-deletion scan covers the complete inventory",
    "no ordinary backup copies were expected"
  ],
  "partial_failed_or_unknown_blocks_gate_i09": true,
  "receipt_proves_procedure_not_physical_erasure": true,
  "receipt_hash_contract": {
    "algorithm": "SHA-256",
    "canonicalization": "JSON object with sorted keys, compact separators and receipt_sha256 omitted",
    "self_digest_binds": "all required receipt fields except receipt_sha256"
  },
  "single_use_receipt_id_required": true,
  "single_use_caller_nonce_required": true,
  "replayed_receipt_id_or_caller_nonce_blocks_consumption": true,
  "real_receipt_present": false,
  "gate_i09_pass": false,
  "selection_allowed": false
}
