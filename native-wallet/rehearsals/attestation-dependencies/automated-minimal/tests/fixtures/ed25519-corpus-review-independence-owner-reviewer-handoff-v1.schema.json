{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.obsidian.invalid/native-wallet/ed25519-corpus-review-independence-owner-reviewer-handoff-v1.schema.json",
  "title": "Evidence-only accountable-owner and independent-reviewer handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoff_id",
    "decision_result_sha256",
    "context_handoff_sha256",
    "selection_scorecard_sha256",
    "owner_role",
    "owner_identity_id",
    "owner_trust_domain",
    "owner_decision",
    "owner_assertion_sha256",
    "reviewer_role",
    "reviewer_identity_id",
    "reviewer_trust_domain",
    "reviewer_decision",
    "reviewer_assertion_sha256",
    "subject_review_domain_id",
    "issued_at_epoch_ms",
    "expires_at_epoch_ms",
    "caller_nonce_sha256",
    "handoff_sha256",
    "selected_option",
    "owner_authenticated",
    "independent_reviewer_authenticated",
    "decision_accepted",
    "production_authorized",
    "selection_allowed",
    "crypto_call_allowed",
    "runtime_integration_allowed"
  ],
  "properties": {
    "schema": { "const": "native-wallet-ed25519-corpus-review-independence-owner-reviewer-handoff.v1" },
    "handoff_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "decision_result_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "context_handoff_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selection_scorecard_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "owner_role": { "const": "ACCOUNTABLE_OWNER" },
    "owner_identity_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "owner_trust_domain": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "owner_decision": { "enum": ["ACCEPT", "DEFER", "REJECT"] },
    "owner_assertion_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewer_role": { "const": "INDEPENDENT_REVIEWER" },
    "reviewer_identity_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "reviewer_trust_domain": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "reviewer_decision": { "enum": ["ACCEPT", "DEFER", "REJECT"] },
    "reviewer_assertion_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "subject_review_domain_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "issued_at_epoch_ms": { "type": "integer", "minimum": 1 },
    "expires_at_epoch_ms": { "type": "integer", "minimum": 1 },
    "caller_nonce_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "handoff_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selected_option": { "const": null },
    "owner_authenticated": { "const": false },
    "independent_reviewer_authenticated": { "const": false },
    "decision_accepted": { "const": false },
    "production_authorized": { "const": false },
    "selection_allowed": { "const": false },
    "crypto_call_allowed": { "const": false },
    "runtime_integration_allowed": { "const": false }
  },
  "maximum_lifetime_ms": 86400000,
  "maximum_future_skew_ms": 1000,
  "single_use_handoff_id_required": true,
  "single_use_caller_nonce_required": true,
  "role_identity_domain_separation_required": true,
  "assertion_digests_must_be_distinct": true,
  "decision_result_and_context_must_be_exact": true,
  "structural_handoff_is_not_authenticated_acceptance": true,
  "production_authorized": false,
  "selection_allowed": false,
  "crypto_call_allowed": false,
  "runtime_integration_allowed": false
}
