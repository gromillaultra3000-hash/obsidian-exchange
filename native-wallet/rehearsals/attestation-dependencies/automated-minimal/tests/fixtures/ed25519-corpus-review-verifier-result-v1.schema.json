{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.obsidian.invalid/native-wallet/ed25519-corpus-review-verifier-result-v1.schema.json",
  "title": "External WebAuthn verification result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "review_request_sha256",
    "evidence_id",
    "assertion_envelope_sha256",
    "challenge_sha256",
    "credential_root_sha256",
    "revocation_epoch",
    "rp_id",
    "origin",
    "algorithm",
    "credential_type",
    "client_data_type",
    "user_present",
    "user_verified",
    "backup_eligible",
    "backup_state",
    "challenge_matches",
    "rp_id_matches",
    "origin_matches",
    "credential_allowed",
    "credential_not_revoked",
    "signature_valid",
    "result_issued_at_epoch_ms",
    "result_expires_at_epoch_ms",
    "verified_at_epoch_ms",
    "caller_nonce_sha256",
    "verifier_policy_sha256",
    "verifier_identity",
    "verifier_build_sha256",
    "decision"
  ],
  "properties": {
    "schema": { "const": "native-wallet-ed25519-corpus-review-verifier-result.v1" },
    "profile": { "const": "WEBAUTHN_L3_CTAP22_ROAMING_ES256_UV" },
    "review_request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence_id": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "assertion_envelope_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "challenge_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "credential_root_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revocation_epoch": { "type": "integer", "minimum": 1 },
    "rp_id": { "type": "string", "minLength": 1, "maxLength": 253 },
    "origin": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "algorithm": { "const": "ES256" },
    "credential_type": { "const": "public-key" },
    "client_data_type": { "const": "webauthn.get" },
    "user_present": { "const": true },
    "user_verified": { "const": true },
    "backup_eligible": { "const": false },
    "backup_state": { "const": false },
    "challenge_matches": { "const": true },
    "rp_id_matches": { "const": true },
    "origin_matches": { "const": true },
    "credential_allowed": { "const": true },
    "credential_not_revoked": { "const": true },
    "signature_valid": { "const": true },
    "result_issued_at_epoch_ms": { "type": "integer", "minimum": 1 },
    "result_expires_at_epoch_ms": { "type": "integer", "minimum": 1 },
    "verified_at_epoch_ms": { "type": "integer", "minimum": 1 },
    "caller_nonce_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verifier_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verifier_identity": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "verifier_build_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision": { "const": "VERIFIED" }
  },
  "ordered_validation": [
    "bounded_closed_result_shape",
    "known_verifier_identity_and_build",
    "exact_review_request_and_policy_digests",
    "fresh_monotonic_revocation_epoch",
    "single_use_caller_nonce_and_evidence_id",
    "exact_assertion_envelope_digest",
    "exact_challenge_digest",
    "exact_allowlisted_rp_id_and_origin",
    "allowed_non_revoked_credential_root",
    "webauthn_profile_flags_and_es256_signature",
    "issue_and_expiry_window"
  ],
  "result_signature_or_attestation_defined": false,
  "external_verifier_selected": false,
  "reviewer_authenticated": false,
  "crypto_call_allowed": false,
  "runtime_integration_allowed": false
}
