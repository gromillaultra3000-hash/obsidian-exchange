{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.obsidian.invalid/native-wallet/ed25519-corpus-review-response-v1.schema.json",
  "title": "Ed25519 public corpus independent review response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_sha256",
    "reviewer_id",
    "trust_domain",
    "reviewer_role",
    "reviewed_at",
    "checks",
    "decision",
    "authentication"
  ],
  "properties": {
    "schema": {
      "const": "native-wallet-ed25519-corpus-review-response.v1"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "trust_domain": {
      "type": "string",
      "enum": [
        "independent_security",
        "standards_and_licensing",
        "reproducible_build"
      ]
    },
    "reviewer_role": {
      "const": "non_generator_reviewer"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_digest_matches",
        "provenance_digest_matches",
        "decision_record_digest_matches",
        "public_key_matches_source",
        "message_matches_source",
        "signature_matches_source",
        "no_private_or_seed_material",
        "mutation_expectations_reviewed",
        "license_treatment_reviewed"
      ],
      "properties": {
        "corpus_digest_matches": { "const": true },
        "provenance_digest_matches": { "const": true },
        "decision_record_digest_matches": { "const": true },
        "public_key_matches_source": { "const": true },
        "message_matches_source": { "const": true },
        "signature_matches_source": { "const": true },
        "no_private_or_seed_material": { "const": true },
        "mutation_expectations_reviewed": { "const": true },
        "license_treatment_reviewed": { "const": true }
      }
    },
    "decision": {
      "enum": ["APPROVE", "REJECT"]
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "evidence_id",
        "challenge_sha256",
        "credential_root_sha256",
        "recovery_authority_id",
        "revocation_epoch",
        "issued_at_epoch_ms",
        "expires_at_epoch_ms",
        "assertion_envelope_sha256"
      ],
      "properties": {
        "profile": { "const": "WEBAUTHN_L3_CTAP22_ROAMING_ES256_UV" },
        "evidence_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "challenge_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "credential_root_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "recovery_authority_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "revocation_epoch": { "type": "integer", "minimum": 1 },
        "issued_at_epoch_ms": { "type": "integer", "minimum": 1 },
        "expires_at_epoch_ms": { "type": "integer", "minimum": 1 },
        "assertion_envelope_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
