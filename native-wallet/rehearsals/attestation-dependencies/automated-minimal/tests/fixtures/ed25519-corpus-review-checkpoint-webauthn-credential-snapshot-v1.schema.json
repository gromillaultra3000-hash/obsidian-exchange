{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.obsidian.invalid/native-wallet/ed25519-corpus-review-checkpoint-webauthn-credential-snapshot-v1.schema.json",
  "title": "Consumer-selected WebAuthn witness credential snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "policy_id", "witness_slot", "witness_domain_id", "root_record_sha256",
    "credential_id_bytes_sha256", "cose_public_key_bytes_sha256", "algorithm",
    "credential_type", "rp_id", "origin", "backup_eligible", "enrollment_provenance_sha256",
    "user_handle_bytes_sha256", "epoch", "status", "valid_from_epoch_ms",
    "valid_until_epoch_ms", "recovery_authority_id", "previous_snapshot_sha256"
  ],
  "properties": {
    "schema": { "const": "native-wallet-ed25519-corpus-review-checkpoint-webauthn-credential-snapshot.v1" },
    "policy_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "witness_slot": { "type": "integer", "minimum": 0, "maximum": 1 },
    "witness_domain_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "root_record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "credential_id_bytes_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cose_public_key_bytes_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "algorithm": { "const": "ES256" },
    "credential_type": { "const": "public-key" },
    "rp_id": { "type": "string", "minLength": 1, "maxLength": 253 },
    "origin": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "backup_eligible": { "const": false },
    "enrollment_provenance_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "user_handle_bytes_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "epoch": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["ACTIVE", "REVOKED", "RETIRED", "COMPROMISED"] },
    "valid_from_epoch_ms": { "type": "integer", "minimum": 1 },
    "valid_until_epoch_ms": { "type": "integer", "minimum": 1 },
    "recovery_authority_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "previous_snapshot_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  },
  "consumer_selection_inputs": ["policy_id", "witness_slot", "witness_domain_id", "epoch"],
  "assertion_credential_id_used_for_selection": false,
  "credential_or_public_key_bytes_embedded": false,
  "cose_key_parsing_implemented": false,
  "credential_store_implemented": false,
  "real_credential_present": false,
  "crypto_call_allowed": false
}
