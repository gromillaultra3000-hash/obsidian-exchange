  "ambientPolicy": [
    "PUBLIC_CONNECT_TEMP_SCHEMA_FUNCTION_REVOKED",
    "NO_SCHEMA_CREATE",
    "NO_TEMP",
    "NO_ROLE_MEMBERSHIP",
    "NO_DIRECT_TABLE_DML",
    "NO_DIRECT_TABLE_SELECT",
    "NO_DIRECT_SEQUENCE_ACCESS",
    "FIXED_PG_CATALOG_SEARCH_PATH",
    "STATEMENT_TIMEOUT_REQUIRED",
    "LOCK_TIMEOUT_REQUIRED"
  ],
  "singleProcessConstraint": "The current exchange-bot process mixes owner, operator and background calls, so one login necessarily receives the union of all 135 function EXECUTEs. Splitting those authorities requires separate process identities and pools; it is not claimed by this plan.",
  "functionAcceptance": [
    "exact input SQL types and bounded sizes",
    "closed return shape",
    "package invariants enforced inside one transaction",
    "owner predicates enforced inside functions",
    "fresh row lock or CAS where declared",
    "fixed search_path pg_catalog",
    "schema-qualified relations",
    "PUBLIC execute revoked",
    "owner is NOLOGIN and has only body-required grants",
    "login has only exact function execute",
    "malicious input concurrency and injected-fault rollback tests"
  ],
