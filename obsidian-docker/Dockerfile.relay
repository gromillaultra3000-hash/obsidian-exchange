FROM python:3.12-slim
WORKDIR /app
RUN pip install fastapi uvicorn aiofiles qrcode requests Pillow
COPY relay/main_docker.py /app/main.py
COPY relay/webapp.html /app/
COPY relay/providers/ /app/providers/
COPY relay/services/ /app/services/
COPY relay/utils/ /app/utils/
COPY relay/config/ /app/config/
COPY exchange.db /app/
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000"]
