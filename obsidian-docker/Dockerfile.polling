FROM python:3.12-slim
WORKDIR /app
RUN pip install requests
COPY relay/services/polling_service.py /app/
COPY relay/utils/ /app/utils/
COPY relay/config/ /app/config/
COPY bot/.env /app/
COPY exchange.db /app/
CMD ["python", "-c", "from polling_service import start_polling_service; start_polling_service()"]
