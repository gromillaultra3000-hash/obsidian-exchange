[Unit]
Description=Obsidian B64 snapshot-reader dormant-authority watchdog
Requires=obsidian-postgres.service
BindsTo=obsidian-postgres.service
After=obsidian-postgres.service
ConditionPathExists=/opt/obsidian-exchange/releases/e0-e0.3-b5.3-064a/387fab2a90f7c89c837c8ca92bac381bdf55c96b/deploy/postgres/b64_snapshot_reader_watchdog.py
ConditionPathExists=/opt/obsidian-exchange/releases/e0-e0.3-b5.3-064a/387fab2a90f7c89c837c8ca92bac381bdf55c96b/deploy/postgres/verify_b64_snapshot_reader.py
ConditionPathExists=/opt/obsidian-exchange/releases/e0-e0.3-b5.3-064a/387fab2a90f7c89c837c8ca92bac381bdf55c96b/deploy/postgres/load_sqlite_snapshot.py
ConditionPathExists=/opt/obsidian-exchange/releases/e0-e0.3-b5.3-064a/387fab2a90f7c89c837c8ca92bac381bdf55c96b/deploy/postgres/verify_runtime_privileges.py

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/obsidian-exchange
ExecStart=/opt/obsidian-exchange/relay-venv/bin/python /opt/obsidian-exchange/releases/e0-e0.3-b5.3-064a/387fab2a90f7c89c837c8ca92bac381bdf55c96b/deploy/postgres/b64_snapshot_reader_watchdog.py --expected-image-id sha256:7456ef82e5f5bc43d997f4781bbd7c0d6389bff397564649a356e206ba473aee --expected-server-version-num 170011 --require-dormant --cleanup-recovery
TimeoutStartSec=180
TimeoutStopSec=10
KillMode=control-group
Restart=no

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock /var/lib/docker/volumes/obsidian-postgres-data/_data/.obsidian-b64-hba-v1 -/var/lib/obsidian-exchange/b64-064a-activation/journal -/var/lib/obsidian-exchange/b64-064a-activation/resources -/var/lib/obsidian-exchange/b64-064a-activation/workspace -/var/lib/obsidian-exchange/b64-064a-activation/proxy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
