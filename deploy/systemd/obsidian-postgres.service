# Production template only. Install deliberately after provisioning the
# secret, persistent-volume backup policy, pinned image and restore test.
[Unit]
Description=ObsidianExchange PostgreSQL 17
Documentation=file:/opt/obsidian-exchange/docs/postgresql-cutover-runbook.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
Wants=obsidian-b64-snapshot-reader-watchdog.timer
StartLimitIntervalSec=300
StartLimitBurst=3
ConditionPathExists=/opt/obsidian-exchange/deploy/postgres/compose.production.yml
ConditionPathExists=/etc/obsidian-exchange/postgres/postgres-password
ConditionPathExists=/opt/obsidian-exchange/deploy/postgres/verify_b64_snapshot_reader.py
ConditionPathExists=/opt/obsidian-exchange/deploy/postgres/load_sqlite_snapshot.py
ConditionPathExists=/opt/obsidian-exchange/deploy/postgres/verify_runtime_privileges.py

[Service]
Type=simple
WorkingDirectory=/opt/obsidian-exchange
ExecStartPre=/usr/bin/docker compose --project-name obsidian-postgres --file /opt/obsidian-exchange/deploy/postgres/compose.production.yml config --quiet
ExecStart=/usr/bin/docker compose --project-name obsidian-postgres --file /opt/obsidian-exchange/deploy/postgres/compose.production.yml up --force-recreate --no-color --no-log-prefix --abort-on-container-exit --exit-code-from postgres
ExecStartPost=/bin/sh -ec 'i=0; while [ "$$i" -lt 60 ]; do status=$$(/usr/bin/docker inspect --format={{.State.Health.Status}} obsidian-postgres 2>/dev/null || true); [ "$$status" = healthy ] && exit 0; i=$$((i + 1)); sleep 1; done; exit 1'
ExecStartPost=/opt/obsidian-exchange/relay-venv/bin/python /opt/obsidian-exchange/deploy/postgres/b64_snapshot_reader_transition_gate.py --expected-image-id sha256:7456ef82e5f5bc43d997f4781bbd7c0d6389bff397564649a356e206ba473aee --expected-server-version-num 170011 --apply
ExecStartPost=/opt/obsidian-exchange/relay-venv/bin/python -B /opt/obsidian-exchange/releases/e0-e0.3-b5.3-064a/e725d49932107d128b1621b7bdb37e2d499872cb/deploy/postgres/b64_snapshot_reader_watchdog.py --expected-image-id sha256:7456ef82e5f5bc43d997f4781bbd7c0d6389bff397564649a356e206ba473aee --expected-server-version-num 170011 --require-dormant
ExecStop=/opt/obsidian-exchange/relay-venv/bin/python /opt/obsidian-exchange/deploy/postgres/b64_postgres_shutdown.py
TimeoutStartSec=120
TimeoutStopSec=210
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock /var/lib/docker/volumes/obsidian-postgres-data/_data/.obsidian-b64-hba-v1
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
