[Unit]
Description=Obsidian B64 signed one-shot production activation launcher
Requires=obsidian-postgres.service
Requires=obsidian-b64-snapshot-reader-watchdog.timer
BindsTo=obsidian-postgres.service
After=obsidian-postgres.service obsidian-b64-snapshot-reader-watchdog.timer obsidian-b64-snapshot-reader-watchdog.service
ConditionPathExists=/opt/obsidian-exchange/releases/e0-e0.3-b5.3-064a/dd1934f865381ae139b4cb6037d157ff34d825b2/deploy/postgres/b64_064a_activation_launcher.py
ConditionPathExists=/etc/obsidian-exchange/postgres/admin.active.env

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/obsidian-exchange/releases/e0-e0.3-b5.3-064a/dd1934f865381ae139b4cb6037d157ff34d825b2
ExecStart=/opt/obsidian-exchange/relay-venv/bin/python -E /opt/obsidian-exchange/releases/e0-e0.3-b5.3-064a/dd1934f865381ae139b4cb6037d157ff34d825b2/deploy/postgres/b64_064a_activation_launcher.py
LoadCredential=observation-env:/etc/obsidian-exchange/postgres/admin.active.env
Environment=PATH=/usr/bin:/bin
Environment=LC_ALL=C
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONINSPECT PYTHONSTARTUP PYTHONWARNINGS PYTHONBREAKPOINT LD_PRELOAD LD_LIBRARY_PATH
UMask=0077
TimeoutStartSec=190
TimeoutStopSec=5
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
Restart=no

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock /var/lib/docker/volumes/obsidian-postgres-data/_data/.obsidian-b64-hba-v1 /var/lib/obsidian-exchange/b64-064a-activation/journal /var/lib/obsidian-exchange/b64-064a-activation/resources /var/lib/obsidian-exchange/b64-064a-activation/workspace /var/lib/obsidian-exchange/b64-064a-activation/proxy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
